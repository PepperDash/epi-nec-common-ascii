<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ProjectType>ProgramLibrary</ProjectType>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFramework>net8</TargetFramework>
    <RootNamespace>EpiNecCommonAscii</RootNamespace>
    <Deterministic>false</Deterministic>
    <AssemblyTitle>NEC Common ASCII</AssemblyTitle>
    <Company>PepperDash Technologies</Company>
    <Description>This software is a plugin designed to work as a part of PepperDash Essentials for Crestron control processors. This plugin allows for control of NEC displays using the common ASCII protocol.</Description>
    <Copyright>Copyright 2026</Copyright>
    <Version>1.0.0-local</Version>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <InformationalVersion>$(Version)</InformationalVersion>
    <Authors>PepperDash Technologies</Authors>
    <PackageId>PepperDash.Essentials.Plugin.NecCommonAscii</PackageId>
    <PackageProjectUrl>https://github.com/PepperDash-Engineering/epi-nec-common-ascii</PackageProjectUrl>
    <PackageTags>crestron 4series nec display</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Properties\**" />
    <Compile Remove="ResponseHandling\AVMuteResponse.cs" />
    <Compile Remove="ResponseHandling\InputResponse.cs" />
    <Compile Remove="ResponseHandling\PowerResponse.cs" />
    <EmbeddedResource Remove="Properties\**" />
    <None Remove="Properties\**" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="*.projectinfo" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="PepperDashEssentials" Version="3.0.0-rc.1">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
